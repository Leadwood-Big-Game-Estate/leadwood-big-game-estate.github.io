<!DOCTYPE html>
<html lang="fr">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
<title>Wildlife Tracker</title>
<link rel="manifest" href="manifest.json">
<style>
* { box-sizing: border-box; margin: 0; padding: 0; -webkit-tap-highlight-color: transparent; }
body { font-family: Arial, sans-serif; background: #f4f4f0; color: #222; height: 100vh; overflow: hidden; display: flex; flex-direction: column; }
#app { display: flex; flex-direction: column; height: 100vh; }
#setup-screen { flex: 1; overflow-y: auto; padding: 20px; }
.setup-card { background: #fff; border: 1px solid #e0e0e0; border-radius: 12px; padding: 16px; margin-bottom: 14px; }
.setup-card h3 { font-size: 14px; font-weight: bold; color: #555; margin-bottom: 12px; }
.upload-zone { border: 2px dashed #ccc; border-radius: 8px; padding: 20px; text-align: center; cursor: pointer; transition: background 0.15s; }
.upload-zone:hover { background: #f9f9f9; }
.upload-zone.has-file { border-color: #1D9E75; background: #eaf3de; color: #1D9E75; }
.coord-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 10px; }
.coord-field label { display: block; font-size: 11px; color: #777; margin-bottom: 4px; }
.coord-field input { width: 100%; padding: 8px 10px; border: 1px solid #ccc; border-radius: 8px; background: #fafafa; color: #222; font-size: 13px; }
.coord-field input:focus { outline: none; border-color: #1D9E75; }
.btn-primary { width: 100%; padding: 13px; border: none; border-radius: 8px; background: #1D9E75; color: white; font-weight: bold; font-size: 15px; cursor: pointer; margin-top: 4px; }
.btn-primary:disabled { background: #ccc; color: #888; cursor: default; }
.setup-hint { font-size: 12px; color: #999; margin-bottom: 10px; line-height: 1.5; }
#map-screen { flex: 1; display: flex; flex-direction: column; overflow: hidden; }
#topbar { display: flex; align-items: center; justify-content: space-between; padding: 8px 12px; background: #fff; border-bottom: 1px solid #e0e0e0; flex-shrink: 0; }
#topbar-left { display: flex; align-items: center; gap: 8px; }
#topbar-title { font-size: 15px; font-weight: bold; }
#gps-badge { font-size: 11px; padding: 3px 8px; border-radius: 20px; border: 1px solid; }
#gps-badge.ok       { color: #3B6D11; border-color: #639922; background: #eaf3de; }
#gps-badge.searching{ color: #854F0B; border-color: #EF9F27; background: #faeeda; }
#gps-badge.error    { color: #A32D2D; border-color: #E24B4A; background: #fcebeb; }
#topbar-right { display: flex; gap: 6px; }
.icon-btn { padding: 5px 9px; border: 1px solid #ccc; border-radius: 8px; background: #f5f5f5; color: #555; font-size: 12px; cursor: pointer; }
#map-area { flex: 1; position: relative; overflow: auto; background: #b8d4a0; }
#map-canvas-wrap { position: relative; display: inline-block; min-width: 100%; min-height: 100%; }
#map-canvas { display: block; }
#svg-overlay { position: absolute; top: 0; left: 0; pointer-events: none; }
.btn-upload-map { padding: 10px 20px; border: 1px solid #1D9E75; border-radius: 8px; background: #fff; color: #1D9E75; font-size: 14px; font-weight: bold; cursor: pointer; }
#bottom-panel { background: #fff; border-top: 1px solid #e0e0e0; padding: 10px 12px 16px; flex-shrink: 0; }
#animal-grid { display: grid; grid-template-columns: repeat(6, 1fr); gap: 6px; margin-bottom: 10px; }
.animal-btn { display: flex; flex-direction: column; align-items: center; gap: 2px; padding: 8px 4px; border: 2px solid #e0e0e0; border-radius: 8px; background: #f9f9f9; cursor: pointer; transition: all 0.1s; }
.animal-btn:active { transform: scale(0.95); }
.animal-btn.selected { border-color: #1D9E75; background: #eaf3de; }
.animal-icon { font-size: 22px; line-height: 1; }
.animal-name { font-size: 9px; color: #666; text-align: center; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; width: 100%; }
.animal-btn.selected .animal-name { color: #3B6D11; }
#report-btn { width: 100%; padding: 13px; border: none; border-radius: 8px; background: #1D9E75; color: white; font-size: 15px; font-weight: bold; cursor: pointer; }
#report-btn:disabled { background: #e0e0e0; color: #aaa; cursor: default; }
#toast { position: fixed; bottom: 170px; left: 50%; transform: translateX(-50%); padding: 9px 18px; border-radius: 20px; font-size: 13px; font-weight: bold; z-index: 100; white-space: nowrap; pointer-events: none; transition: opacity 0.3s; }
#toast.success { background: #eaf3de; color: #3B6D11; border: 1px solid #639922; }
#toast.error   { background: #fcebeb; color: #A32D2D; border: 1px solid #E24B4A; }
#toast.hidden  { opacity: 0; }
#loading-overlay { position: absolute; inset: 0; background: rgba(244,244,240,0.85); display: flex; align-items: center; justify-content: center; z-index: 5; }
#loading-overlay.hidden { display: none; }
.spinner { width: 30px; height: 30px; border: 3px solid #ddd; border-top-color: #1D9E75; border-radius: 50%; animation: spin 0.8s linear infinite; }
@keyframes spin { to { transform: rotate(360deg); } }
@keyframes pulse { 0%,100% { opacity: 0.25; } 50% { opacity: 0.08; } }
.gps-pulse { animation: pulse 2s ease-in-out infinite; }
</style>
</head>
<body>
<div id="app">
  <div id="setup-screen">
    <div style="text-align:center; padding:16px 0 20px;">
      <div style="font-size:32px; margin-bottom:8px;">🐾</div>
      <h1 style="font-size:22px; margin-bottom:4px;">Wildlife Tracker</h1>
      <p style="font-size:13px; color:#888;">Signalez les animaux en temps réel</p>
    </div>
    <div class="setup-card">
      <h3>1 · Importez votre carte PDF</h3>
      <label class="upload-zone" id="upload-zone">
        <input type="file" id="pdf-input" accept=".pdf" style="display:none">
        <div id="upload-text" style="font-size:13px; color:#888;">
          <div style="font-size:26px; margin-bottom:8px;">📂</div>
          Appuyez pour sélectionner le PDF de la réserve
        </div>
      </label>
    </div>
    <button class="btn-primary" id="start-btn">Démarrer →</button>
  </div>

  <div id="map-screen" style="display:none;">
    <div id="topbar">
      <div id="topbar-left">
        <span id="topbar-title">🐾 Wildlife</span>
        <span id="gps-badge" class="searching">GPS…</span>
      </div>
    </div>
    <div id="map-area">
      <div id="loading-overlay"><div class="spinner"></div></div>
      <div id="map-canvas-wrap">
        <canvas id="map-canvas"></canvas>
        <svg id="svg-overlay" width="0" height="0"></svg>
      </div>
    </div>
    <div id="bottom-panel">
      <div id="animal-grid"></div>
      <button id="report-btn" disabled>Sélectionnez un animal</button>
    </div>
  </div>
</div>
<div id="toast" class="hidden"></div>

<script src="https://cdnjs.cloudflare.com/ajax/libs/pdf.js/3.11.174/pdf.min.js"></script>
<script>
pdfjsLib.GlobalWorkerOptions.workerSrc =
  "https://cdnjs.cloudflare.com/ajax/libs/pdf.js/3.11.174/pdf.worker.min.js";

const ANIMALS = [
  { id:"lion", emoji:"🦁", name:"Lion" },
  { id:"elephant", emoji:"🐘", name:"Éléphant" },
  { id:"giraffe", emoji:"🦒", name:"Girafe" },
  { id:"zebra", emoji:"🦓", name:"Zèbre" },
];
const EXPIRY_MS = 5 * 60 * 60 * 1000;

let state = {
  pdfBase64: null,
  bounds: { maxLat:-24.371180, minLng:30.900230, minLat:-24.470152, maxLng:30.995868 },
  sightings: [], selectedAnimal:null, userPos:null,
  gpsStatus:"searching", canvasW:0, canvasH:0, pdfRendered:false,
};
let gpsWatchId = null, toastTimer = null;

function init() {
  buildAnimalGrid();
  bindSetupEvents();
}

function bindSetupEvents() {
  document.getElementById("pdf-input").addEventListener("change", handlePdfUpload);
  document.getElementById("start-btn").addEventListener("click", handleStart);
}

function handlePdfUpload(e) {
  var file = e.target.files[0];
  if (!file) return;
  var reader = new FileReader();
  reader.onload = function(ev) {
    state.pdfBase64 = ev.target.result.split(",")[1];
    document.getElementById("upload-zone").classList.add("has-file");
    document.getElementById("upload-text").innerHTML =
      '<div style="font-size:20px;margin-bottom:4px;">✅</div><strong>' + file.name + '</strong>';
  };
  reader.readAsDataURL(file);
}

function handleStart() {
  if (!state.pdfBase64) { showToast("Importez d'abord votre PDF", "error"); return; }
  document.getElementById("setup-screen").style.display = "none";
  document.getElementById("map-screen").style.display  = "flex";
  renderPdf(state.pdfBase64);
  startGPS();
}

function buildAnimalGrid() {
  var grid = document.getElementById("animal-grid");
  ANIMALS.forEach(a => {
    var btn = document.createElement("button");
    btn.className="animal-btn";
    btn.dataset.id=a.id;
    btn.innerHTML='<span class="animal-icon">'+a.emoji+'</span><span class="animal-name">'+a.name+'</span>';
    btn.addEventListener("click", ()=>selectAnimal(a.id));
    grid.appendChild(btn);
  });
}

function selectAnimal(id) {
  state.selectedAnimal = state.selectedAnimal===id ? null : id;
  document.querySelectorAll(".animal-btn").forEach(b=>b.classList.toggle("selected", b.dataset.id===state.selectedAnimal));
  updateReportBtn();
}

function updateReportBtn() {
  var btn=document.getElementById("report-btn");
  if (!state.selectedAnimal){ btn.textContent="← Sélectionnez un animal"; btn.disabled=true; return; }
  if (state.gpsStatus!=="ok"){ btn.textContent="En attente GPS…"; btn.disabled=true; return; }
  var animal=ANIMALS.find(a=>a.id===state.selectedAnimal);
  btn.textContent="📍 Signaler "+animal.emoji+" "+animal.name;
  btn.disabled=false;
}

function startGPS() {
  if (!navigator.geolocation) { setGpsStatus("error"); return; }
  gpsWatchId = navigator.geolocation.watchPosition(
    pos => { state.userPos={lat:pos.coords.latitude,lng:pos.coords.longitude}; setGpsStatus("ok"); drawOverlay(); },
    ()=>setGpsStatus("error"),
    { enableHighAccuracy:true, maximumAge:5000 }
  );
}

function setGpsStatus(s) {
  state.gpsStatus=s;
  var el=document.getElementById("gps-badge");
  el.className="gps-badge "+s;
  el.textContent={ok:"GPS actif", searching:"GPS…", error:"GPS indisponible"}[s]||s;
  updateReportBtn();
}

function renderPdf(base64) {
  document.getElementById("loading-overlay").classList.remove("hidden");
  var binary=atob(base64); var bytes=new Uint8Array(binary.length);
  for(var i=0;i<binary.length;i++)bytes[i]=binary.charCodeAt(i);
  pdfjsLib.getDocument({data:bytes}).promise.then(page => page.getPage(1)).then(page => {
    var containerW=document.getElementById("map-area").clientWidth||360;
    var vp0=page.getViewport({scale:1});
    var scale=containerW/vp0.width;
    var vp=page.getViewport({scale:scale});
    var canvas=document.getElementById("map-canvas");
    canvas.width=vp.width; canvas.height=vp.height;
    state.canvasW=vp.width; state.canvasH=vp.height;
    var svg=document.getElementById("svg-overlay");
    svg.setAttribute("width",vp.width); svg.setAttribute("height",vp.height);
    return page.render({canvasContext:canvas.getContext("2d"),viewport:vp}).promise;
  }).then(()=>{ state.pdfRendered=true; drawOverlay(); document.getElementById("loading-overlay").classList.add("hidden"); })
  .catch(()=>{ showToast("Erreur PDF","error"); document.getElementById("loading-overlay").classList.add("hidden"); });
}

function gpsToXY(lat,lng){
  var b=state.bounds;
  if(!b||state.canvasW===0)return null;
  return { x:((lng-b.minLng)/(b.maxLng-b.minLng))*state.canvasW,
           y:((b.maxLat-lat)/(b.maxLat-b.minLat))*state.canvasH };
}

function drawOverlay(){
  if(!state.pdfRendered)return;
  var svg=document.getElementById("svg-overlay"); var html="";
  if(state.userPos&&state.gpsStatus==="ok"){
    var p=gpsToXY(state.userPos.lat,state.userPos.lng);
    if(p&&p.x>=0&&p.y>=0&&p.x<=state.canvasW&&p.y<=state.canvasH){
      html+='<g transform="translate('+p.x+','+p.y+')">'
           +'<circle class="gps-pulse" r="18" fill="#185FA5" opacity="0.2"/>'
           +'<circle r="7" fill="#378ADD"/>'
           +'<circle r="7" fill="none" stroke="white" stroke-width="2"/>'
           +'</g>';
    }
  }
  svg.innerHTML=html;
}

function showToast(msg,type){var el=document.getElementById("toast");el.textContent=msg;el.className=type||"success";clearTimeout(toastTimer);toastTimer=setTimeout(()=>{el.className="hidden";},3500);}

init();
</script>
<script>
if('serviceWorker' in navigator){navigator.serviceWorker.register('sw.js');}
</script>
</body>
</html>
