<!DOCTYPE html>

<html lang="fr">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Wildlife Tracker</title>

<link rel="manifest" href="manifest.json">
<meta name="theme-color" content="#1D9E75">

<style>
body {
  margin:0;
  font-family: Arial, sans-serif;
  background:#f4f4f0;
}

header {
  background:#1D9E75;
  color:white;
  padding:12px;
  text-align:center;
  font-weight:bold;
}

#container {
  padding:10px;
}

#map {
  width:100%;
  height:60vh;
  background:#ddd;
  display:flex;
  align-items:center;
  justify-content:center;
  border-radius:10px;
  overflow:hidden;
}

canvas {
  width:100%;
}

button {
  width:100%;
  padding:12px;
  margin-top:10px;
  border:none;
  border-radius:8px;
  background:#1D9E75;
  color:white;
  font-size:16px;
}

.animal {
  display:inline-block;
  padding:10px;
  margin:5px;
  border:1px solid #ccc;
  border-radius:8px;
  cursor:pointer;
}

.selected {
  background:#1D9E75;
  color:white;
}

#toast {
  position:fixed;
  bottom:20px;
  left:50%;
  transform:translateX(-50%);
  background:#333;
  color:white;
  padding:10px 20px;
  border-radius:20px;
}

.hidden { display:none; }
</style>

</head>

<body>

<header>🐾 Wildlife Tracker</header>

<div id="container">

<input type="file" id="pdfInput" accept=".pdf">

<div id="map">
  <span>Charge ton PDF</span>
  <canvas id="canvas"></canvas>
</div>

<button onclick="startGPS()">Activer GPS</button>

<h3>Animaux</h3>
<div id="animals"></div>

<button onclick="report()">Signaler</button>

</div>

<div id="toast" class="hidden"></div>

<script src="https://cdnjs.cloudflare.com/ajax/libs/pdf.js/3.11.174/pdf.min.js"></script>

<script>
let state = {
  pdf:null,
  animal:null,
  gps:null,
  sightings:[]
};

const animals = ["🦁","🐘","🦒","🦓"];

function init(){
  const saved = localStorage.getItem("data");
  if(saved) state = JSON.parse(saved);

  renderAnimals();

  if(state.pdf){
    renderPDF(state.pdf);
  }
}

function save(){
  localStorage.setItem("data", JSON.stringify(state));
}

// ---------- ANIMAUX ----------
function renderAnimals(){
  const div = document.getElementById("animals");
  div.innerHTML="";
  animals.forEach(a=>{
    const el = document.createElement("div");
    el.className="animal";
    if(state.animal===a) el.classList.add("selected");
    el.innerText=a;
    el.onclick=()=>{
      state.animal=a;
      renderAnimals();
    };
    div.appendChild(el);
  });
}

// ---------- PDF ----------
document.getElementById("pdfInput").addEventListener("change", e=>{
  const file = e.target.files[0];
  if(!file) return;

  const reader = new FileReader();
  reader.onload = function(ev){
    state.pdf = ev.target.result;
    save();
    renderPDF(state.pdf);
    show("PDF chargé");
  };
  reader.readAsDataURL(file);
});

function renderPDF(data){
  const canvas = document.getElementById("canvas");
  const ctx = canvas.getContext("2d");

  const loadingTask = pdfjsLib.getDocument(data);
  loadingTask.promise.then(pdf=>{
    return pdf.getPage(1);
  }).then(page=>{
    const viewport = page.getViewport({scale:1});
    const scale = canvas.parentElement.clientWidth / viewport.width;
    const vp = page.getViewport({scale:scale});

    canvas.width = vp.width;
    canvas.height = vp.height;

    return page.render({
      canvasContext: ctx,
      viewport: vp
    }).promise;
  }).catch(()=>{
    show("Erreur PDF");
  });
}

// ---------- GPS ----------
function startGPS(){
  if(!navigator.geolocation){
    show("GPS non supporté");
    return;
  }

  navigator.geolocation.watchPosition(pos=>{
    state.gps = {
      lat:pos.coords.latitude,
      lng:pos.coords.longitude
    };
    save();
    show("GPS actif");
  }, ()=>{
    show("Erreur GPS");
  });
}

// ---------- REPORT ----------
function report(){
  if(!state.animal || !state.gps){
    show("Choisir animal + GPS");
    return;
  }

  state.sightings.push({
    animal:state.animal,
    gps:state.gps,
    time:Date.now()
  });

  save();
  show("Signalé !");
}

// ---------- TOAST ----------
function show(msg){
  const t = document.getElementById("toast");
  t.innerText=msg;
  t.classList.remove("hidden");
  setTimeout(()=>t.classList.add("hidden"),2000);
}

// ---------- PWA ----------
if("serviceWorker" in navigator){
  navigator.serviceWorker.register("sw.js");
}

init();
</script>

</body>
</html>
